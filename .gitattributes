# Normalize all text files to LF in repo
* text=auto eol=lf

# Explicit source files
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.env  text eol=lf

# Windows scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files (never modify)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary